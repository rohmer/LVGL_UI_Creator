get_filename_component(CREATOR_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(ESPOS_TEST_SOURCE_ROOT "" CACHE PATH "Explicit ESPOS project whose pinned dependency and board adapter are tested")
if(ESPOS_TEST_SOURCE_ROOT)
    get_filename_component(espos_test_project "${ESPOS_TEST_SOURCE_ROOT}" ABSOLUTE)
    include("${espos_test_project}/tools/advanced_keyboard_dependency.cmake")
    espos_require_advanced_keyboard()
    set(espos_templates "${espos_test_project}")
else()
    include("${CREATOR_ROOT}/cmake/AdvancedKeyboardDependency.cmake")
    set(ADVANCED_KEYBOARD_ROOT "${ADVKBD_SOURCE_ROOT}")
    set(espos_templates "${CREATOR_ROOT}/Integrations/ESPOS/templates")
endif()
set(core "${ADVANCED_KEYBOARD_ROOT}/src")
set(public_headers "${ADVANCED_KEYBOARD_ROOT}/include")
set(espos_adapter "${ADVANCED_KEYBOARD_ROOT}/integrations/espos")
set(catalog "${ADVANCED_KEYBOARD_ROOT}/models/bundled/catalog.json")
set(model_generator "${ADVANCED_KEYBOARD_ROOT}/tools/models/generate_bundled_models.py")
set(index_builder "${ADVANCED_KEYBOARD_ROOT}/tools/layout/build_ngtr_index.py")
if(NOT EXISTS "${espos_adapter}/TypingView.cpp" OR NOT EXISTS "${catalog}")
    message(FATAL_ERROR "AdvancedKeyboard checkout lacks its canonical ESPOS adapter or model catalog")
endif()
get_filename_component(catalog_directory "${catalog}" DIRECTORY)
