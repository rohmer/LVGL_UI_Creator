include_guard(GLOBAL)

# Explicit source dependency only. Component discovery never fetches or edits
# a checkout, and a project without its own Git repository remains supported.
function(espos_require_advanced_keyboard)
    get_filename_component(project_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(lock "${project_root}/advanced-keyboard.lock.json")
    set(setup "python \"${project_root}/tools/setup_advanced_keyboard.py\" --project-root \"${project_root}\" --kind espos --init")
    if(NOT EXISTS "${lock}")
        message(FATAL_ERROR "AdvancedKeyboard dependency lock is missing: ${lock}\nRestore the project lock, then run: ${setup}")
    endif()
    file(READ "${lock}" document)
    string(JSON lock_version ERROR_VARIABLE error GET "${document}" version)
    if(NOT error STREQUAL "NOTFOUND" OR NOT lock_version STREQUAL "1")
        message(FATAL_ERROR "Unsupported AdvancedKeyboard dependency lock: ${lock}")
    endif()
    foreach(field repository revision)
        string(JSON value ERROR_VARIABLE error GET "${document}" "${field}")
        if(NOT error STREQUAL "NOTFOUND" OR NOT value)
            message(FATAL_ERROR "Invalid AdvancedKeyboard lock field ${field}: ${lock}")
        endif()
        set(locked_${field} "${value}")
    endforeach()
    string(LENGTH "${locked_revision}" revision_length)
    if(NOT revision_length EQUAL 40 OR NOT locked_revision MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "AdvancedKeyboard lock must pin a full 40-character revision")
    endif()
    string(JSON default_path ERROR_VARIABLE error GET "${document}" paths espos)
    if(NOT error STREQUAL "NOTFOUND" OR NOT default_path)
        message(FATAL_ERROR "Invalid AdvancedKeyboard paths.espos in ${lock}")
    endif()
    file(TO_CMAKE_PATH "${default_path}" checked_path)
    if(IS_ABSOLUTE "${checked_path}" OR checked_path MATCHES "(^|/)[.][.](/|$)" OR
       checked_path MATCHES "(^|/)[.]git(/|$)" OR checked_path MATCHES ":" OR checked_path MATCHES "^[.]/?$")
        message(FATAL_ERROR "AdvancedKeyboard paths.espos must stay inside the project root")
    endif()
    if(DEFINED ADVANCED_KEYBOARD_ROOT AND NOT ADVANCED_KEYBOARD_ROOT STREQUAL "")
        get_filename_component(dependency "${ADVANCED_KEYBOARD_ROOT}" ABSOLUTE BASE_DIR "${project_root}")
    else()
        get_filename_component(dependency "${default_path}" ABSOLUTE BASE_DIR "${project_root}")
    endif()
    foreach(required
        CMakeLists.txt cmake/AdvancedKeyboardSources.cmake src/PredictionModel.cpp src/PredictionPrefix.cpp src/Utf8Fold.cpp src/PredictionStorage.cpp
        src/Prediction.cpp src/AdvancedKeyboard.cpp src/BundledModels.cpp include/lv_advanced_keyboard.h
        include/espos_keyboard/BundledModels.h integrations/espos/TypingView.cpp integrations/espos/esp_runtime.cpp
        integrations/espos/include/espos_keyboard/LegacyTypingView.h models/bundled/catalog.json
        tools/models/generate_bundled_models.py tools/layout/build_ngtr_index.py)
        if(NOT EXISTS "${dependency}/${required}")
            message(FATAL_ERROR "AdvancedKeyboard dependency is missing ${required}: ${dependency}\nRun: ${setup}")
        endif()
    endforeach()
    # A nested clone or submodule owns .git. Never resolve the surrounding
    # ESPOS/home repository when a source-only dependency has no .git entry.
    if(EXISTS "${dependency}/.git")
        find_program(advanced_keyboard_git NAMES git REQUIRED)
        execute_process(COMMAND "${advanced_keyboard_git}" -C "${dependency}" rev-parse --show-toplevel
            RESULT_VARIABLE status OUTPUT_VARIABLE owner ERROR_VARIABLE details OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Cannot verify AdvancedKeyboard checkout: ${details}\nRun: ${setup}")
        endif()
        get_filename_component(owner "${owner}" REALPATH)
        get_filename_component(expected_owner "${dependency}" REALPATH)
        if(WIN32)
            string(TOLOWER "${owner}" owner)
            string(TOLOWER "${expected_owner}" expected_owner)
        endif()
        if(NOT owner STREQUAL expected_owner)
            message(FATAL_ERROR "AdvancedKeyboard .git resolves to a different repository: ${owner}")
        endif()
        execute_process(COMMAND "${advanced_keyboard_git}" -C "${dependency}" rev-parse HEAD
            RESULT_VARIABLE status OUTPUT_VARIABLE actual_revision ERROR_VARIABLE details OUTPUT_STRIP_TRAILING_WHITESPACE)
        string(TOLOWER "${actual_revision}" actual_revision)
        string(TOLOWER "${locked_revision}" locked_revision)
        if(NOT status EQUAL 0 OR NOT actual_revision STREQUAL locked_revision)
            message(FATAL_ERROR "AdvancedKeyboard revision differs from lock: ${actual_revision}, expected ${locked_revision}\nRun: ${setup}")
        endif()
    endif()
    set(ADVANCED_KEYBOARD_ROOT "${dependency}" PARENT_SCOPE)
    set(ADVKBD_SOURCE_ROOT "${dependency}" PARENT_SCOPE)
endfunction()
