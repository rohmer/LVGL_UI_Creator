set(prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(app "${prefix}/@UICREATOR_LINUX_APP_DIRECTORY@")
set(arguments --path "${app}" --allowed-root "${app}" --library-directory "${app}/lib")
set(directories "@UICREATOR_LINUX_DEPENDENCY_DIRECTORIES@")
foreach(directory IN LISTS directories)
    if(directory)
        list(APPEND arguments --library-directory "${directory}")
    endif()
endforeach()
if(NOT "@CMAKE_SYSROOT@" STREQUAL "")
    list(APPEND arguments --sysroot "@CMAKE_SYSROOT@")
endif()
execute_process(COMMAND "@Python3_EXECUTABLE@" "@PROJECT_SOURCE_DIR@/Packaging/Linux/linux_package.py"
    closure --architecture "@UICREATOR_LINUX_ARCH@" --readelf "@UICREATOR_LINUX_READELF@" ${arguments}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Target-only ELF dependency resolution failed: ${output}${error}")
endif()
file(MAKE_DIRECTORY "${app}/lib")
string(JSON count LENGTH "${output}" libraries)
math(EXPR last "${count} - 1")
if(count GREATER 0)
foreach(index RANGE 0 ${last})
    string(JSON library GET "${output}" libraries ${index} source)
    string(JSON alias GET "${output}" libraries ${index} name)
    string(FIND "${library}" "${app}/" inside)
    if(NOT inside EQUAL 0)
        file(COPY "${library}" DESTINATION "${app}/lib")
        get_filename_component(name "${library}" NAME)
        if(NOT name STREQUAL alias AND NOT EXISTS "${app}/lib/${alias}")
            file(CREATE_LINK "${name}" "${app}/lib/${alias}" SYMBOLIC)
        endif()
    endif()
endforeach()
endif()
# Source mirrors on mounted Windows volumes can report every resource as 0777.
# Keep executable ELF/scripts executable and install ordinary data read-only to
# other users, independent of the source filesystem's permission emulation.
file(GLOB_RECURSE installed LIST_DIRECTORIES true "${app}/*")
list(APPEND installed "${app}")
foreach(member IN LISTS installed)
    if(IS_SYMLINK "${member}")
        continue()
    endif()
    if(IS_DIRECTORY "${member}")
        file(CHMOD "${member}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    else()
        file(READ "${member}" magic LIMIT 4 HEX)
        if(magic STREQUAL "7f454c46" OR magic MATCHES "^2321")
            file(CHMOD "${member}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
        else()
            file(CHMOD "${member}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
        endif()
    endif()
endforeach()
set(require_sdks)
if("@UICREATOR_LINUX_REQUIRE_SDKS@")
    set(require_sdks --require-sdks)
endif()
execute_process(COMMAND "@Python3_EXECUTABLE@" "@PROJECT_SOURCE_DIR@/Packaging/Linux/linux_package.py"
    manifest --root "${prefix}" --architecture "@UICREATOR_LINUX_ARCH@" --version "@PROJECT_VERSION@"
    --readelf "@UICREATOR_LINUX_READELF@" ${require_sdks}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Linux package validation failed: ${output}${error}")
endif()
message(STATUS "${output}")
