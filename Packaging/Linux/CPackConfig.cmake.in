set(configuration "${CPACK_BUILD_CONFIG}")
if(NOT configuration)
    set(configuration "@CMAKE_BUILD_TYPE@")
endif()
include("@PROJECT_BINARY_DIR@/LinuxPackageInputs-${configuration}.cmake")
set(arguments --allowed-root "@PROJECT_BINARY_DIR@")
foreach(input IN LISTS UICREATOR_LINUX_PACKAGE_INPUTS)
    list(APPEND arguments --path "${input}")
endforeach()
set(directories "@UICREATOR_LINUX_DEPENDENCY_DIRECTORIES@")
foreach(directory IN LISTS directories)
    if(directory)
        list(APPEND arguments --library-directory "${directory}")
    endif()
endforeach()
if(NOT "@CMAKE_SYSROOT@" STREQUAL "")
    list(APPEND arguments --sysroot "@CMAKE_SYSROOT@")
endif()
execute_process(COMMAND "@Python3_EXECUTABLE@" "@PROJECT_SOURCE_DIR@/Packaging/Linux/linux_package.py"
    closure --architecture "@UICREATOR_LINUX_ARCH@" --readelf "@UICREATOR_LINUX_READELF@" ${arguments}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot resolve target-only ELF dependencies: ${output}${error}")
endif()
string(JSON CPACK_DEBIAN_PACKAGE_DEPENDS GET "${output}" abi debianDepends)
# linux_package.py also declares dynamically loaded desktop/libcurl runtimes so
# the payload manifest and the DEB dependency contract stay identical.
