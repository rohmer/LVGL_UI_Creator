# Release artifacts contain editor/compiler runtimes, converters and license notices.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    include("${CMAKE_CURRENT_LIST_DIR}/LinuxRelease.cmake")
    return()
endif()
if(WIN32)
    enable_language(RC)
    target_sources(UICreator PRIVATE "${PROJECT_SOURCE_DIR}/Packaging/UICreator.rc")
    target_include_directories(UICreator PRIVATE "${PROJECT_SOURCE_DIR}/Packaging")
    if(TARGET UICreatorViewer)
        target_sources(UICreatorViewer PRIVATE "${PROJECT_SOURCE_DIR}/Packaging/UICreatorViewer.rc")
        target_include_directories(UICreatorViewer PRIVATE "${PROJECT_SOURCE_DIR}/Packaging")
    endif()
    set_source_files_properties(
        "${PROJECT_SOURCE_DIR}/Packaging/UICreator.rc"
        "${PROJECT_SOURCE_DIR}/Packaging/UICreatorViewer.rc"
        PROPERTIES OBJECT_DEPENDS "${PROJECT_SOURCE_DIR}/Packaging/UICreator.ico;${PROJECT_SOURCE_DIR}/Packaging/ResourceIds.h")
    if(BUILD_TESTING AND TARGET UICreatorViewer)
        find_package(Python3 COMPONENTS Interpreter REQUIRED)
        add_test(NAME UICreatorApplicationIcon
            COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/Packaging/VerifyIcon.py"
                --icon "${PROJECT_SOURCE_DIR}/Packaging/UICreator.ico"
                --executable "$<TARGET_FILE:UICreator>" --executable "$<TARGET_FILE:UICreatorViewer>"
                --report "${PROJECT_BINARY_DIR}/application-icon/resource-verification.json")
        set_tests_properties(UICreatorApplicationIcon PROPERTIES LABELS "packaging;icons" TIMEOUT 30)
    endif()
    if(MSVC)
        string(REGEX REPLACE "/VC/Tools/MSVC/.*" "/VC/Redist/MSVC" redist_root "${CMAKE_CXX_COMPILER}")
        if(CMAKE_SIZEOF_VOID_P EQUAL 8)
            set(redist_arch x64)
        else()
            set(redist_arch x86)
        endif()
        file(GLOB runtime_dirs "${redist_root}/*/${redist_arch}/Microsoft.VC*.CRT")
        list(SORT runtime_dirs COMPARE NATURAL ORDER DESCENDING)
        if(runtime_dirs)
            list(GET runtime_dirs 0 runtime_dir)
            install(DIRECTORY "${runtime_dir}/" DESTINATION . FILES_MATCHING PATTERN "*.dll")
        else()
            message(WARNING "MSVC redistributable runtime not found; release users will need the matching Visual C++ runtime.")
        endif()
    endif()
endif()
install(TARGETS UICreator LVGLCompiler UICreatorCodeGen RUNTIME DESTINATION .)
if(TARGET LVGLProtobufDisplay)
    install(TARGETS LVGLProtobufDisplay UICreatorViewer RUNTIME DESTINATION . ARCHIVE DESTINATION sdk/windows/lib)
    install(FILES "${PROJECT_SOURCE_DIR}/Runtime/windows/include/lvgl_pb_display.h" DESTINATION sdk/windows/include)
endif()
install(FILES "${PROJECT_BINARY_DIR}/packages/LVGLProtobuf-ESP32-Toolkit.zip" DESTINATION sdk/esp32 OPTIONAL)
install(FILES "${PROJECT_BINARY_DIR}/packages/LVGLProtobufDisplay-windows.zip" DESTINATION sdk/windows OPTIONAL)
install(FILES "${PROJECT_BINARY_DIR}/packages/LVGLProtobuf-Arduino-Toolkit.zip" DESTINATION sdk/arduino OPTIONAL)
install(FILES "${PROJECT_BINARY_DIR}/packages/LVGLProtobuf-Linux-Toolkit.zip"
    "${PROJECT_BINARY_DIR}/packages/LVGLProtobuf-Linux-Keyboard-Profile.zip"
    "${PROJECT_BINARY_DIR}/packages/LVGLProtobuf-Linux-aarch64-keyboard.tar.gz"
    "${PROJECT_BINARY_DIR}/packages/LVGLProtobuf-Linux-x86_64.tar.gz" DESTINATION sdk/linux OPTIONAL)
if(WIN32)
    install(FILES $<TARGET_RUNTIME_DLLS:UICreator> DESTINATION .)
endif()
install(DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/font-converter"
