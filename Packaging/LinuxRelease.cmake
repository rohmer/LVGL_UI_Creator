include(GNUInstallDirs)
find_package(Python3 COMPONENTS Interpreter REQUIRED)
set(UICREATOR_LINUX_APP_DIRECTORY "lib/lvgl-ui-creator")
set(UICREATOR_LINUX_SDK_DIRECTORY "${PROJECT_BINARY_DIR}/packages" CACHE PATH "Published device and native SDK archives to include")
set(UICREATOR_LINUX_DEPENDENCY_DIRECTORIES "" CACHE STRING "Target-only shared-library search directories for Linux packaging")
set(UICREATOR_LINUX_OBJDUMP "${CMAKE_OBJDUMP}" CACHE FILEPATH "Target ELF objdump used for dependency resolution")
set(UICREATOR_LINUX_READELF "readelf" CACHE FILEPATH "ELF readelf tool used for architecture and ABI checks")
option(UICREATOR_LINUX_REQUIRE_SDKS "Require complete published SDKs when packaging the desktop editor" ON)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(UICREATOR_LINUX_ARCH aarch64)
    set(UICREATOR_LINUX_DEB_ARCH arm64)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    set(UICREATOR_LINUX_ARCH x86_64)
    set(UICREATOR_LINUX_DEB_ARCH amd64)
else()
    message(FATAL_ERROR "Linux desktop packages support x86_64 and aarch64; got ${CMAKE_SYSTEM_PROCESSOR}")
endif()
foreach(target UICreator LVGLCompiler UICreatorCodeGen UICreatorViewer)
    if(NOT TARGET ${target})
        message(FATAL_ERROR "Full Linux desktop packaging requires target ${target}")
    endif()
    set_target_properties(${target} PROPERTIES INSTALL_RPATH "$ORIGIN;$ORIGIN/lib")
    install(TARGETS ${target} RUNTIME DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}")
endforeach()
if(TARGET LVGLProtobufLinux)
    set_target_properties(LVGLProtobufLinux PROPERTIES INSTALL_RPATH "$ORIGIN")
    install(TARGETS LVGLProtobufLinux LIBRARY DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/lib")
endif()
if(TARGET SDL3-shared)
    set_target_properties(SDL3-shared PROPERTIES INSTALL_RPATH "$ORIGIN")
    install(TARGETS SDL3-shared LIBRARY DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/lib")
endif()
if(TARGET freetype)
    get_target_property(freetype_type freetype TYPE)
    if(freetype_type STREQUAL "SHARED_LIBRARY")
        set_target_properties(freetype PROPERTIES INSTALL_RPATH "$ORIGIN")
        install(TARGETS freetype LIBRARY DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/lib")
    endif()
endif()
foreach(pair "lvgl-ui-creator|UICreator" "lvgl-compiler|LVGLCompiler" "uicreator-codegen|UICreatorCodeGen" "uicreator-viewer|UICreatorViewer")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 launcher)
    list(GET fields 1 UICREATOR_LAUNCH_TARGET)
    configure_file("${CMAKE_CURRENT_LIST_DIR}/Linux/launcher.sh.in" "${PROJECT_BINARY_DIR}/linux-launchers/${launcher}" @ONLY NEWLINE_STYLE UNIX)
    install(PROGRAMS "${PROJECT_BINARY_DIR}/linux-launchers/${launcher}" DESTINATION bin)
endforeach()
install(FILES "${CMAKE_CURRENT_LIST_DIR}/Linux/lvgl-ui-creator.desktop" DESTINATION share/applications)
install(FILES "${CMAKE_CURRENT_LIST_DIR}/Linux/lvgl-ui-creator.svg" DESTINATION share/icons/hicolor/scalable/apps)
foreach(helper font-converter image-converter project-creator language-models python-runtime)
    install(DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/${helper}" DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}" USE_SOURCE_PERMISSIONS)
endforeach()
foreach(pair "esp32|LVGLProtobuf-ESP32-Toolkit.zip"
             "arduino|LVGLProtobuf-Arduino-Toolkit.zip"
             "windows|LVGLProtobufDisplay-windows.zip" "linux|LVGLProtobuf-Linux-Toolkit.zip"
             "linux|LVGLProtobuf-Linux-Keyboard-Profile.zip" "linux|LVGLProtobuf-Linux-aarch64-keyboard.tar.gz"
             "linux|LVGLProtobuf-Linux-x86_64.tar.gz")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 platform)
    list(GET fields 1 archive)
    install(FILES "${UICREATOR_LINUX_SDK_DIRECTORY}/${archive}" DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/sdk/${platform}" OPTIONAL)
    install(FILES "${UICREATOR_LINUX_SDK_DIRECTORY}/${archive}.sha256" DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/sdk/${platform}" OPTIONAL)
endforeach()
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" "${CMAKE_CURRENT_LIST_DIR}/THIRD_PARTY_NOTICES.md" DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/licenses")
if(UICREATOR_FONT_NODE)
    get_filename_component(node_directory "${UICREATOR_FONT_NODE}" DIRECTORY)
    foreach(notice "${node_directory}/LICENSE" "${node_directory}/../LICENSE")
        if(EXISTS "${notice}")
            install(FILES "${notice}" DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/licenses/Node" RENAME LICENSE)
            break()
        endif()
    endforeach()
endif()
foreach(dependency SDL3 freetype-2.10.1 spdlog-1.x Breakpad Catch2 libimagequant nanopb MXML)
    foreach(notice LICENSE LICENSE.txt LICENSE.TXT COPYING COPYING.txt COPYRIGHT README.md docs/FTL.TXT docs/GPLv2.TXT)
        if(EXISTS "${PROJECT_SOURCE_DIR}/3rdParty/${dependency}/${notice}")
            install(FILES "${PROJECT_SOURCE_DIR}/3rdParty/${dependency}/${notice}" DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/licenses/${dependency}")
        endif()
    endforeach()
endforeach()
install(FILES "${PROJECT_SOURCE_DIR}/3rdParty/LVGL/lvgl/LICENCE.txt" DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/licenses/LVGL" OPTIONAL)
install(FILES "${PROJECT_SOURCE_DIR}/3rdParty/JSON/json.hpp" DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/licenses/JSON")
install(FILES "${PROJECT_SOURCE_DIR}/ImgLib/stb_image.h" "${PROJECT_SOURCE_DIR}/ImgLib/stb.h" DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/licenses/stb")
install(DIRECTORY "${PROJECT_SOURCE_DIR}/LVSerial/Widgets/AdvancedKeyboard/" DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/licenses/AdvancedKeyboard"
    FILES_MATCHING PATTERN "*LICENSE*" PATTERN "README.md" PATTERN "PROVENANCE.md")
foreach(document BUILD.md EDITOR_WORKFLOWS.md Packaging/RELEASE_NOTES.md Packaging/LINUX.md
        Runtime/PERFORMANCE.md Runtime/INTERACTIONS.md UICreator/README.md UICreator/SESSION.md UICreator/AdvancedKeyboard.md
        UICreator/Bootstrap.md UICreator/Codes.md Docs/Themes-and-components.md Docs/Responsive-previews.md Docs/Professional-workflows.md
        Runtime/README.md Runtime/linux/README.md Runtime/arduino/README.md Runtime/esp32/README.md Runtime/windows/README.md
        UICreator/ProjectCreator/README.md UICreator/Devices/README.md UICreator/Validation/README.md Tests/README.md)
    get_filename_component(directory "${document}" DIRECTORY)
    install(FILES "${PROJECT_SOURCE_DIR}/${document}" DESTINATION "${UICREATOR_LINUX_APP_DIRECTORY}/docs/${directory}" OPTIONAL)
endforeach()

configure_file("${CMAKE_CURRENT_LIST_DIR}/Linux/CollectDependencies.cmake.in" "${PROJECT_BINARY_DIR}/LinuxCollectDependencies.cmake" @ONLY)
install(SCRIPT "${PROJECT_BINARY_DIR}/LinuxCollectDependencies.cmake")
set(UICREATOR_LINUX_PACKAGE_INPUTS "$<TARGET_FILE:UICreator>;$<TARGET_FILE:UICreatorViewer>;$<TARGET_FILE:LVGLCompiler>;$<TARGET_FILE:UICreatorCodeGen>;${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/font-converter;${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/image-converter;${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/project-creator;${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/language-models;${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/python-runtime")
file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/LinuxPackageInputs-$<CONFIG>.cmake" CONTENT "set(UICREATOR_LINUX_PACKAGE_INPUTS \"${UICREATOR_LINUX_PACKAGE_INPUTS}\")\n")
configure_file("${CMAKE_CURRENT_LIST_DIR}/Linux/CPackConfig.cmake.in" "${PROJECT_BINARY_DIR}/LinuxCPackConfig.cmake" @ONLY)
set(CPACK_PROJECT_CONFIG_FILE "${PROJECT_BINARY_DIR}/LinuxCPackConfig.cmake")
set(CPACK_PACKAGE_NAME "LVGL-UI-Creator")
set(CPACK_PACKAGE_VENDOR "LVGL UI Creator contributors")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Native LVGL visual editor and firmware tools")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_GENERATOR "DEB;TGZ")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/packages")
set(package_arch "${UICREATOR_LINUX_ARCH}")
if(package_arch STREQUAL "aarch64")
    set(package_arch arm64)
endif()
set(CPACK_PACKAGE_FILE_NAME "LVGL-UI-Creator-${PROJECT_VERSION}-Linux-${package_arch}")
set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
set(CPACK_DEBIAN_PACKAGE_NAME lvgl-ui-creator)
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "${UICREATOR_LINUX_DEB_ARCH}")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "LVGL UI Creator contributors")
set(CPACK_DEBIAN_PACKAGE_SECTION devel)
set(CPACK_DEBIAN_PACKAGE_PRIORITY optional)
set(CPACK_DEBIAN_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}.deb")
# Dependencies are derived from target ELF symbol requirements by the project
# config. Host dpkg-shlibdeps would resolve cross libraries to *-cross packages.
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS OFF)
set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "libdecor-0-0, libasound2t64 | libasound2, libpulse0")
include(CPack)
add_custom_target(UICreatorLinuxPackages
    COMMAND "${CMAKE_CPACK_COMMAND}" --config "${PROJECT_BINARY_DIR}/CPackConfig.cmake" -C $<CONFIG>
    DEPENDS UICreator LVGLCompiler UICreatorCodeGen UICreatorViewer USES_TERMINAL VERBATIM)
