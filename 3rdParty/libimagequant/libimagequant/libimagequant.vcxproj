    <CargoExecutable Condition="'$(CargoExecutable)'==''">cargo.exe</CargoExecutable>
    <RustTarget>x86_64-pc-windows-msvc</RustTarget>
    <VCBuildArchitecture>x64</VCBuildArchitecture>
    <VCBuildArchitecture Condition="'$(Platform)'=='Win32'">x86</VCBuildArchitecture>
