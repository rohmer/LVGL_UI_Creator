foreach(mode crash terminate)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(dump_directory "${DUMP_ROOT}/${run_id}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "UICREATOR_DUMP_DIR=${dump_directory}" "SDL_VIDEO_DRIVER=dummy" "SDL_RENDER_DRIVER=software"
    "${EDITOR}" --${mode}-test RESULT_VARIABLE result TIMEOUT 20)
if("${result}" STREQUAL "0")
    message(FATAL_ERROR "Crash test exited successfully instead of crashing")
endif()
file(GLOB dumps "${dump_directory}/*.dmp")
list(LENGTH dumps count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one Breakpad crash dump, found ${count}. Process result: ${result}")
endif()
list(GET dumps 0 dump)
file(READ "${dump}" signature LIMIT 4 HEX)
file(SIZE "${dump}" dump_size)
if(NOT signature STREQUAL "4d444d50" OR dump_size LESS 1024)
    message(FATAL_ERROR "Crash handler did not produce a valid Windows minidump")
endif()
message(STATUS "Breakpad captured an unhandled exception in ${dump} (${dump_size} bytes)")
endforeach()

