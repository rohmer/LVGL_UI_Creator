foreach(name ui.c ui.h ui_assets.c ui_assets.h ui_requirements.h CMakeLists.txt README.md manifest.json)
    file(SHA256 "${GENERATED_DIR}/${name}" expected)
    foreach(format from-json from-protobuf)
        file(SHA256 "${GENERATED_DIR}/${format}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "${format}/${name} differs from the original export")
        endif()
    endforeach()
endforeach()
