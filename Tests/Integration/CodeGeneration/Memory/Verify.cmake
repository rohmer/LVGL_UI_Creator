function(run_step name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${BINARY_DIR}/${name}.log" "${output}${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Generated memory ${TARGET_VERSION}: ${name} failed (${result}). See ${BINARY_DIR}/${name}.log\n${output}${error}")
    endif()
endfunction()
file(MAKE_DIRECTORY "${BINARY_DIR}")
find_library(memory_lvgl NAMES lvgl PATHS "${LVGL_BUILD_DIR}" "${LVGL_BUILD_DIR}/Release" NO_DEFAULT_PATH)
if(NOT memory_lvgl)
    message(FATAL_ERROR "Run LVGLGenerator for ${TARGET_VERSION} first to prepare its LVGL archive")
endif()
run_step(generate "${COMPILER}" "${SOURCE_ROOT}/Tests/Integration/CodeGeneration/Memory/project.json"
    --target "${TARGET_VERSION}" --format c --output "${BINARY_DIR}/generated")
file(READ "${BINARY_DIR}/generated/ui_assets.c" asset_source)
if(asset_source MATCHES "_frames\\[\\]|_delays\\[\\]")
    message(FATAL_ERROR "Single-frame images retained unused animation tables")
endif()
string(REGEX MATCHALL "const uint8_t ui_bytes_[0-9]+\\[\\]" immutable_buffers "${asset_source}")
list(LENGTH immutable_buffers immutable_buffer_count)
if(NOT immutable_buffer_count EQUAL 1)
    message(FATAL_ERROR "Expected one deduplicated image pixel buffer; got ${immutable_buffer_count}")
endif()
find_program(memory_ninja ninja REQUIRED)
run_step(configure "${CMAKE_COMMAND}" -S "${SOURCE_ROOT}/Tests/Integration/CodeGeneration/Memory"
    -B "${BINARY_DIR}" -G Ninja -DCMAKE_BUILD_TYPE=Release
    "-DLVGL_ARCHIVE=${memory_lvgl}" "-DLVGL_SOURCE_DIR=${LVGL_SOURCE_DIR}" "-DGENERATED_DIR=${BINARY_DIR}/generated")
run_step(build "${CMAKE_COMMAND}" --build "${BINARY_DIR}" --config Release --parallel 3)
run_step(tests "${CMAKE_CTEST_COMMAND}" --test-dir "${BINARY_DIR}" -C Release --output-on-failure)
