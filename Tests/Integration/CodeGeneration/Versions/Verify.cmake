function(run_step name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${BINARY_DIR}/${name}.log" "${output}${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${TARGET_VERSION}: ${name} failed (${result}). See ${BINARY_DIR}/${name}.log\n${error}")
    endif()
endfunction()
file(MAKE_DIRECTORY "${BINARY_DIR}")
run_step(generate_widgets "${COMPILER}" "${FIXTURE_DIR}/fixture.json" --target "${TARGET_VERSION}" --format c --output "${BINARY_DIR}/generated")
run_step(generate_assets "${COMPILER}" "${ASSET_PROJECT}" --target "${TARGET_VERSION}" --format c --output "${BINARY_DIR}/assets")
find_program(version_ninja ninja)
if(version_ninja)
    set(generator Ninja)
else()
    set(generator "${PARENT_GENERATOR}")
endif()
run_step(configure "${CMAKE_COMMAND}" -S "${SOURCE_ROOT}/Tests/Integration/CodeGeneration/Versions" -B "${BINARY_DIR}"
    -G "${generator}" -DCMAKE_BUILD_TYPE=Release "-DLVGL_SOURCE_DIR=${LVGL_SOURCE_DIR}"
    "-DGENERATED_DIR=${BINARY_DIR}/generated" "-DASSET_DIR=${BINARY_DIR}/assets" "-DFIXTURE_DIR=${FIXTURE_DIR}")
run_step(build "${CMAKE_COMMAND}" --build "${BINARY_DIR}" --config Release --parallel 6)
run_step(functional "${CMAKE_CTEST_COMMAND}" --test-dir "${BINARY_DIR}" -C Release --output-on-failure)
