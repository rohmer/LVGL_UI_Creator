function(run_step name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${BINARY_DIR}/${name}.log" "${output}${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${TARGET_VERSION}: ${name} failed (${result}). See ${BINARY_DIR}/${name}.log\n${error}")
    endif()
endfunction()
file(MAKE_DIRECTORY "${BINARY_DIR}")
set(generator_parent_options)
set(generator_requested_toolchain "")
if(PARENT_TOOLCHAIN)
    get_filename_component(generator_requested_toolchain "${PARENT_TOOLCHAIN}" REALPATH BASE_DIR "${BINARY_DIR}")
endif()
if(EXISTS "${BINARY_DIR}/CMakeCache.txt")
    file(STRINGS "${BINARY_DIR}/CMakeCache.txt" generator_cached_toolchain
        REGEX "^CMAKE_TOOLCHAIN_FILE:[^=]*=")
    string(REGEX REPLACE "^[^=]*=" "" generator_cached_toolchain "${generator_cached_toolchain}")
    if(generator_cached_toolchain)
        get_filename_component(generator_cached_toolchain "${generator_cached_toolchain}" REALPATH BASE_DIR "${BINARY_DIR}")
    endif()
    if(NOT generator_cached_toolchain STREQUAL generator_requested_toolchain)
        list(APPEND generator_parent_options --fresh)
    endif()
endif()
if(PARENT_TOOLCHAIN)
    list(APPEND generator_parent_options "-DCMAKE_TOOLCHAIN_FILE=${PARENT_TOOLCHAIN}")
endif()
set(generator_compiler_emulator)
if(PARENT_EMULATOR_SETTINGS)
    include("${PARENT_EMULATOR_SETTINGS}")
    set(generator_compiler_emulator "${CMAKE_CROSSCOMPILING_EMULATOR}")
    list(APPEND generator_parent_options -C "${PARENT_EMULATOR_SETTINGS}")
endif()
run_step(generate_widgets ${generator_compiler_emulator} "${COMPILER}" "${FIXTURE_DIR}/fixture.json" --target "${TARGET_VERSION}" --format c --output "${BINARY_DIR}/generated")
run_step(generate_assets ${generator_compiler_emulator} "${COMPILER}" "${ASSET_PROJECT}" --target "${TARGET_VERSION}" --format c --output "${BINARY_DIR}/assets")
find_program(version_ninja ninja)
if(version_ninja)
    set(generator Ninja)
else()
    set(generator "${PARENT_GENERATOR}")
endif()
run_step(configure "${CMAKE_COMMAND}" ${generator_parent_options} -S "${SOURCE_ROOT}/Tests/Integration/CodeGeneration/Versions" -B "${BINARY_DIR}"
    -G "${generator}" -DCMAKE_BUILD_TYPE=Release "-DLVGL_SOURCE_DIR=${LVGL_SOURCE_DIR}"
    "-DGENERATED_DIR=${BINARY_DIR}/generated" "-DASSET_DIR=${BINARY_DIR}/assets" "-DFIXTURE_DIR=${FIXTURE_DIR}")
run_step(build "${CMAKE_COMMAND}" --build "${BINARY_DIR}" --config Release --parallel 6)
run_step(functional "${CMAKE_CTEST_COMMAND}" --test-dir "${BINARY_DIR}" -C Release --output-on-failure)
