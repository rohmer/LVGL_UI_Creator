function(run_compiler)
    execute_process(COMMAND "${COMPILER}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "LVGLCompiler failed (${result}): ${output}${error}")
    endif()
endfunction()
function(reject expected)
    execute_process(COMMAND "${COMPILER}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL expected)
        message(FATAL_ERROR "Expected exit ${expected}, got ${result}: ${output}${error}")
    endif()
endfunction()
set(output "${GENERATED_DIR}/compiler-tests")
file(MAKE_DIRECTORY "${output}")
run_compiler(--help)
run_compiler("${GENERATED_DIR}/fixture.json" --format c --output "${output}/c")
run_compiler("${GENERATED_DIR}/fixture.json" --format protobuf --output "${output}/project.pb")
run_compiler("${output}/project.pb" -f c -o "${output}/from-protobuf")
run_compiler("${output}/project.pb" -f pb -o "${output}/second.pb")
file(SHA256 "${output}/project.pb" first)
file(SHA256 "${output}/second.pb" second)
if(NOT first STREQUAL second)
    message(FATAL_ERROR "Protobuf recompilation is not deterministic")
endif()
foreach(name ui.c ui.h ui_assets.c ui_assets.h ui_requirements.h CMakeLists.txt README.md manifest.json)
    file(SHA256 "${GENERATED_DIR}/${name}" expected)
    foreach(format c from-protobuf)
        file(SHA256 "${output}/${format}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Compiler ${format}/${name} differs from existing C output")
        endif()
    endforeach()
endforeach()
file(WRITE "${output}/invalid.json" "{}")
reject(1 "${output}/invalid.json" -f protobuf -o "${output}/invalid.pb")
reject(1 "${GENERATED_DIR}/fixture.json" -f protobuf -o "${GENERATED_DIR}/fixture.json")
reject(1 "${output}/missing.json" -o "${output}/missing")
reject(2 "${GENERATED_DIR}/fixture.json" --format invalid --output "${output}/bad")
reject(2 "${GENERATED_DIR}/fixture.json" --output)
reject(2 --unknown)
# Each target stamp must survive binary recompilation without adding defaults.
foreach(target 9.6 9.5 9.3 9.2 9.1 8.3)
    run_compiler("${GENERATED_DIR}/fixture.json" --target "${target}" -f pb -o "${output}/${target}.pb")
    run_compiler("${output}/${target}.pb" --target "${target}" -f pb -o "${output}/${target}-again.pb")
    file(SHA256 "${output}/${target}.pb" before)
    file(SHA256 "${output}/${target}-again.pb" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Target ${target} binary roundtrip changed output")
    endif()
endforeach()
reject(1 "${GENERATED_DIR}/fixture.json" --target 7.0 -o "${output}/unsupported")
reject(2 "${GENERATED_DIR}/fixture.json" --target)
