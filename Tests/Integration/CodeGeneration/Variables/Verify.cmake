function(run_step name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${BINARY_DIR}/${name}.log" "${output}${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Generated variables ${TARGET_VERSION}: ${name} failed (${result}). See ${BINARY_DIR}/${name}.log\n${output}${error}")
    endif()
endfunction()
foreach(required COMPILER TARGET_VERSION LVGL_SOURCE_DIR LVGL_BUILD_DIR BINARY_DIR SOURCE_ROOT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Set ${required} to run generated variable checks")
    endif()
endforeach()
file(MAKE_DIRECTORY "${BINARY_DIR}")
find_library(variables_lvgl NAMES lvgl PATHS "${LVGL_BUILD_DIR}" "${LVGL_BUILD_DIR}/Release" NO_DEFAULT_PATH)
if(NOT variables_lvgl)
    message(FATAL_ERROR "Run LVGLGenerator for ${TARGET_VERSION} first to prepare its LVGL archive")
endif()
run_step(generate "${COMPILER}" "${SOURCE_ROOT}/Tests/Integration/CodeGeneration/Variables/project.json"
    --target "${TARGET_VERSION}" --format c --output "${BINARY_DIR}/generated")
file(READ "${BINARY_DIR}/generated/manifest.json" manifest)
string(JSON variable_count LENGTH "${manifest}" variables)
if(NOT variable_count EQUAL 16)
    message(FATAL_ERROR "Generated variable manifest lost definitions")
endif()
string(JSON first_legacy GET "${manifest}" variables 12 field)
string(JSON second_legacy GET "${manifest}" variables 13 field)
if(NOT first_legacy STREQUAL "v_legacy_label" OR NOT second_legacy STREQUAL "v_legacy_label_14")
    message(FATAL_ERROR "Legacy variable identifier collision handling changed")
endif()
string(JSON pointer_type GET "${manifest}" variables 0 cType)
string(JSON binding_count LENGTH "${manifest}" variables 0 bindings)
if(NOT pointer_type STREQUAL "int32_t" OR NOT binding_count EQUAL 8)
    message(FATAL_ERROR "Generated variable manifest lost typed pointer or shared targets")
endif()

# Unknown code types, executable-looking symbols, wrong directions and input-only
# labels must fail before any destination files are published.
file(READ "${SOURCE_ROOT}/Tests/Integration/CodeGeneration/Variables/project.json" project)
foreach(invalid_type "int *" "uint64_t" "int32_t; void injected(void)")
    string(JSON invalid SET "${project}" variables 0 var code cType "\"${invalid_type}\"")
    file(WRITE "${BINARY_DIR}/invalid.json" "${invalid}")
    execute_process(COMMAND "${COMPILER}" "${BINARY_DIR}/invalid.json" --target "${TARGET_VERSION}" --format c --output "${BINARY_DIR}/invalid-output"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(result EQUAL 0 OR EXISTS "${BINARY_DIR}/invalid-output/ui.c")
        message(FATAL_ERROR "Invalid variable code type was exported: ${invalid_type}")
    endif()
endforeach()
string(JSON invalid SET "${project}" variables 0 var code symbol "\"level); injected(); /*\"")
file(WRITE "${BINARY_DIR}/invalid.json" "${invalid}")
execute_process(COMMAND "${COMPILER}" "${BINARY_DIR}/invalid.json" --target "${TARGET_VERSION}" --format c --output "${BINARY_DIR}/invalid-output"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "Executable-looking variable symbol was exported")
endif()
string(JSON invalid SET "${project}" variables 0 var bindings 0 direction "\"both\"")
file(WRITE "${BINARY_DIR}/invalid.json" "${invalid}")
execute_process(COMMAND "${COMPILER}" "${BINARY_DIR}/invalid.json" --target "${TARGET_VERSION}" --format c --output "${BINARY_DIR}/invalid-output"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "Invalid variable binding direction was exported")
endif()
string(JSON invalid SET "${project}" variables 0 var bindings 3 direction "\"from-widget\"")
file(WRITE "${BINARY_DIR}/invalid.json" "${invalid}")
execute_process(COMMAND "${COMPILER}" "${BINARY_DIR}/invalid.json" --target "${TARGET_VERSION}" --format c --output "${BINARY_DIR}/invalid-output"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "A noninteractive label was accepted as variable input")
endif()

find_program(variables_ninja ninja REQUIRED)
run_step(configure "${CMAKE_COMMAND}" -S "${SOURCE_ROOT}/Tests/Integration/CodeGeneration/Variables"
    -B "${BINARY_DIR}" -G Ninja -DCMAKE_BUILD_TYPE=Release
    "-DLVGL_ARCHIVE=${variables_lvgl}" "-DLVGL_SOURCE_DIR=${LVGL_SOURCE_DIR}" "-DGENERATED_DIR=${BINARY_DIR}/generated")
run_step(build "${CMAKE_COMMAND}" --build "${BINARY_DIR}" --config Release --parallel 3)
run_step(tests "${CMAKE_CTEST_COMMAND}" --test-dir "${BINARY_DIR}" -C Release --output-on-failure)
