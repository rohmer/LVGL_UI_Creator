function(run_step name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${BINARY_DIR}/${name}.log" "${output}${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Project creator ${name} failed (${result}): ${output}${error}")
    endif()
endfunction()
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 suffix)
set(BINARY_DIR "${BINARY_DIR}/run-${suffix}")
file(MAKE_DIRECTORY "${BINARY_DIR}")
set(project_creator_parent_options)
if(PARENT_TOOLCHAIN)
    # Each run uses a new child directory, so it cannot inherit a host cache.
    list(APPEND project_creator_parent_options "-DCMAKE_TOOLCHAIN_FILE=${PARENT_TOOLCHAIN}")
endif()
set(project_creator_emulator)
if(PARENT_EMULATOR_SETTINGS)
    include("${PARENT_EMULATOR_SETTINGS}")
    set(project_creator_emulator "${CMAKE_CROSSCOMPILING_EMULATOR}")
    list(APPEND project_creator_parent_options -C "${PARENT_EMULATOR_SETTINGS}")
endif()
run_step(template "${PYTHON}" "${SOURCE_ROOT}/Tests/Integration/ProjectCreator/Template.py" "${BINARY_DIR}/template.zip")
run_step(create ${project_creator_emulator} "${CREATOR_TEST}" "${SOURCE_ROOT}" "${BINARY_DIR}/output" "${BINARY_DIR}/template.zip")
find_library(lvgl_archive NAMES lvgl PATHS "${LVGL_BUILD_DIR}" "${LVGL_BUILD_DIR}/Release" NO_DEFAULT_PATH)
find_program(creator_ninja ninja)
if(creator_ninja)
    set(generator Ninja)
else()
    set(generator "${PARENT_GENERATOR}")
endif()
run_step(configure "${CMAKE_COMMAND}" ${project_creator_parent_options} -S "${BINARY_DIR}/output/c-project" -B "${BINARY_DIR}/board-build" -G "${generator}"
    -DCMAKE_BUILD_TYPE=Release "-DLVGL_ARCHIVE=${lvgl_archive}" "-DLVGL_SOURCE_DIR=${SOURCE_ROOT}/3rdParty/LVGL/lvgl")
run_step(build "${CMAKE_COMMAND}" --build "${BINARY_DIR}/board-build" --config Release --parallel 4)
run_step(boot "${CMAKE_CTEST_COMMAND}" --test-dir "${BINARY_DIR}/board-build" -C Release --output-on-failure)
