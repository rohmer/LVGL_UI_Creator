cmake_minimum_required(VERSION 3.24)
foreach(required TEST VIEWER OUTPUT_DIR PYTHON)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(ENV{SDL_VIDEO_DRIVER} dummy)
set(ENV{SDL_RENDER_DRIVER} software)
function(run_step)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Active-screen check failed (${result})\n${output}\n${errors}")
    endif()
    message(STATUS "${output}")
endfunction()
run_step("${TEST}" "${OUTPUT_DIR}")
run_step("${VIEWER}" "${OUTPUT_DIR}/active_second.pb" --frames 6 --screenshot "${OUTPUT_DIR}/viewer_authored.bmp")
run_step("${VIEWER}" "${OUTPUT_DIR}/active_second.pb" --screen 0 --frames 6 --screenshot "${OUTPUT_DIR}/viewer_override.bmp")
run_step("${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/CheckActive.py" "${OUTPUT_DIR}")
