if(TARGET UICreatorXmlTests OR NOT TARGET UICreatorCodeGen OR NOT LVGL_RUNTIME_TARGET STREQUAL "9.6" OR NOT LVSERIAL_USE_XML)
    return()
endif()
find_package(Python3 COMPONENTS Interpreter REQUIRED)
add_executable(UICreatorXmlTests "${CMAKE_CURRENT_LIST_DIR}/XmlTests.cpp")
target_link_libraries(UICreatorXmlTests PRIVATE LVGLRuntime::Runtime LVSerial)
target_compile_features(UICreatorXmlTests PRIVATE cxx_std_17)
target_compile_definitions(UICreatorXmlTests PRIVATE UICREATOR_XML_SOURCE_ROOT="${PROJECT_SOURCE_DIR}")
if(MSVC)
    target_compile_options(UICreatorXmlTests PRIVATE /utf-8 /Zi)
    target_link_options(UICreatorXmlTests PRIVATE /DEBUG:FULL /OPT:REF /OPT:ICF)
endif()
foreach(case Codec Runtime Lazy Filesystem Malformed)
    string(TOLOWER "${case}" argument)
    add_test(NAME "UICreatorXml${case}" COMMAND UICreatorXmlTests "${argument}")
    set_tests_properties("UICreatorXml${case}" PROPERTIES LABELS "xml;functional;runtime" TIMEOUT 120)
endforeach()
set(xml_fixture "${CMAKE_CURRENT_BINARY_DIR}/xml-tests/fixture")
add_test(NAME UICreatorXmlFixture COMMAND UICreatorXmlTests fixture "${xml_fixture}")
set_tests_properties(UICreatorXmlFixture PROPERTIES FIXTURES_SETUP uicreator_xml_inputs LABELS "xml;fixture" TIMEOUT 30)
add_test(NAME UICreatorXmlCLI COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/test_cli.py"
    --compiler "$<TARGET_FILE:LVGLCompiler>" --codegen "$<TARGET_FILE:UICreatorCodeGen>"
    --fixture "${xml_fixture}" --output "${CMAKE_CURRENT_BINARY_DIR}/xml-tests/cli")
set_tests_properties(UICreatorXmlCLI PROPERTIES FIXTURES_REQUIRED uicreator_xml_inputs LABELS "xml;functional;export;cli" TIMEOUT 120)
