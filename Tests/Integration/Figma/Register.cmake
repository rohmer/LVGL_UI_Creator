if(TARGET UICreatorFigmaTests OR NOT TARGET UICreatorCodeGeneration OR NOT UICREATOR_USE_LVGL9)
    return()
endif()
add_executable(UICreatorFigmaOnlineTests
    "${CMAKE_CURRENT_LIST_DIR}/FigmaOnlineTests.cpp"
    "${PROJECT_SOURCE_DIR}/UICreator/Imports/FigmaOnline.cpp"
    "${PROJECT_SOURCE_DIR}/UICreator/Imports/FigmaHttp.cpp")
target_link_libraries(UICreatorFigmaOnlineTests PRIVATE UICreatorCodeGeneration LVGLRuntime::Runtime LVSerial ${CMAKE_DL_LIBS})
target_compile_features(UICreatorFigmaOnlineTests PRIVATE cxx_std_17)
target_compile_definitions(UICreatorFigmaOnlineTests PRIVATE UICREATOR_FIGMA_SOURCE_ROOT="${PROJECT_SOURCE_DIR}")
if(WIN32)
    target_link_libraries(UICreatorFigmaOnlineTests PRIVATE winhttp)
else()
    target_include_directories(UICreatorFigmaOnlineTests PRIVATE "${PROJECT_SOURCE_DIR}/3rdParty/Breakpad/src")
endif()
if(MSVC)
    target_compile_options(UICreatorFigmaOnlineTests PRIVATE /utf-8)
endif()
foreach(case Urls Workflow Failures Cancellation Batching Limits)
    string(TOLOWER "${case}" argument)
    add_test(NAME "UICreatorFigmaOnline${case}" COMMAND UICreatorFigmaOnlineTests "${argument}")
    set_tests_properties("UICreatorFigmaOnline${case}" PROPERTIES LABELS "figma;functional;import;network" TIMEOUT 60)
endforeach()
add_test(NAME UICreatorFigmaOnlineExports COMMAND UICreatorFigmaOnlineTests exports "${CMAKE_CURRENT_BINARY_DIR}/figma-tests/online-exports")
set_tests_properties(UICreatorFigmaOnlineExports PROPERTIES LABELS "figma;functional;import;network;export;runtime" TIMEOUT 120)
add_executable(UICreatorFigmaTests "${CMAKE_CURRENT_LIST_DIR}/FigmaTests.cpp")
target_link_libraries(UICreatorFigmaTests PRIVATE UICreatorCodeGeneration LVGLRuntime::Runtime LVSerial)
target_compile_features(UICreatorFigmaTests PRIVATE cxx_std_17)
target_compile_definitions(UICreatorFigmaTests PRIVATE UICREATOR_FIGMA_SOURCE_ROOT="${PROJECT_SOURCE_DIR}")
if(MSVC)
    target_compile_options(UICreatorFigmaTests PRIVATE /utf-8)
endif()
foreach(case Mapping Formats Assets Malformed Geometry)
    string(TOLOWER "${case}" argument)
    add_test(NAME "UICreatorFigma${case}" COMMAND UICreatorFigmaTests "${argument}")
    set_tests_properties("UICreatorFigma${case}" PROPERTIES LABELS "figma;functional;import" TIMEOUT 45)
endforeach()
add_test(NAME UICreatorFigmaExports COMMAND UICreatorFigmaTests exports "${CMAKE_CURRENT_BINARY_DIR}/figma-tests/exports")
set_tests_properties(UICreatorFigmaExports PROPERTIES LABELS "figma;functional;import;export;runtime" TIMEOUT 120)
find_program(UICREATOR_FIGMA_NODE_EXECUTABLE NAMES node node.exe)
if(UICREATOR_FIGMA_NODE_EXECUTABLE)
    add_test(NAME UICreatorFigmaBridge COMMAND "${UICREATOR_FIGMA_NODE_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/Integrations/Figma/test.mjs")
    set_tests_properties(UICreatorFigmaBridge PROPERTIES LABELS "figma;functional;plugin;import" TIMEOUT 60)
endif()
if(TARGET UICreatorEditorTests)
    target_sources(UICreatorEditorTests PRIVATE "${CMAKE_CURRENT_LIST_DIR}/FigmaEditor.cpp")
    add_test(NAME UICreatorFigmaEditor COMMAND UICreatorEditorTests --figma-import
        "${CMAKE_CURRENT_LIST_DIR}/fixtures/native.figma.json")
    set_tests_properties(UICreatorFigmaEditor PROPERTIES LABELS "figma;functional;editor;import"
        ENVIRONMENT "SDL_VIDEO_DRIVER=dummy;SDL_RENDER_DRIVER=software" TIMEOUT 90)
endif()
