cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED TEST_EXECUTABLES)
    message(FATAL_ERROR "TEST_EXECUTABLES must contain the pipe-separated generated consumers")
endif()
string(REPLACE "|" ";" consumers "${TEST_EXECUTABLES}")
list(LENGTH consumers count)
if(NOT count EQUAL 49)
    message(FATAL_ERROR "Expected 49 generated consumers, received ${count}")
endif()
set(preset 0)
foreach(consumer IN LISTS consumers)
    if(NOT EXISTS "${consumer}")
        message(FATAL_ERROR "Generated consumer is missing: ${consumer}. Build UICreatorBootstrapGenerated first.")
    endif()
    get_filename_component(directory "${consumer}" DIRECTORY)
    execute_process(COMMAND "${consumer}" WORKING_DIRECTORY "${directory}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Preset ${preset} generated C failed (${result})\n${output}\n${errors}")
    endif()
    string(STRIP "${output}" output)
    message(STATUS "${output}")
    math(EXPR preset "${preset}+1")
endforeach()
message(STATUS "All 49 generated C projects compiled and passed native runtime validation")
