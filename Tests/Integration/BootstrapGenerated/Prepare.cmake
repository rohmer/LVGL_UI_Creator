cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED GENERATED_ROOT)
    message(FATAL_ERROR "GENERATED_ROOT is required")
endif()
foreach(preset RANGE 0 48)
    set(directory "${GENERATED_ROOT}/${preset}")
    file(READ "${directory}/fixture.json" fixture)
    file(READ "${directory}/manifest.json" manifest)
    string(JSON object_count LENGTH "${fixture}" obj)
    string(JSON manifest_count LENGTH "${manifest}" objects)
    if(NOT object_count GREATER 0 OR NOT object_count EQUAL manifest_count)
        message(FATAL_ERROR "Preset ${preset}: fixture and manifest object counts differ")
    endif()
    math(EXPR last "${object_count}-1")
    set(objects "static const expected_object_t expected_objects[] = {\n")
    set(actions "static const expected_action_t expected_actions[] = {\n")
    set(action_count 0)
    foreach(index RANGE 0 ${last})
        string(JSON id GET "${fixture}" obj ${index} oid)
        string(JSON parent GET "${fixture}" obj ${index} par)
        string(JSON manifest_id GET "${manifest}" objects ${index} id)
        if(NOT id EQUAL manifest_id)
            message(FATAL_ERROR "Preset ${preset}: manifest ID differs at index ${index}")
        endif()
        string(JSON type GET "${manifest}" objects ${index} type)
        if(type STREQUAL "object")
            set(class "lv_obj_class")
        elseif(type STREQUAL "buttonMatrix")
            set(class "lv_buttonmatrix_class")
        elseif(type STREQUAL "imagebutton")
            set(class "lv_imagebutton_class")
        elseif(type MATCHES "^(arc|bar|button|calendar|canvas|checkbox|image|label|dropdown|roller|slider|spinbox|switch|textarea|led|line|spinner|chart|table|keyboard|tabview|tileview)$")
            set(class "lv_${type}_class")
        else()
            message(FATAL_ERROR "Preset ${preset}: add explicit consumer class validation for ${type}")
        endif()
        string(APPEND objects "    {${id}, ${parent}, &${class}},\n")
        string(JSON action ERROR_VARIABLE no_action GET "${fixture}" obj ${index} base bootstrapAction)
        if(NOT no_action)
            if(action STREQUAL "dismiss")
                string(APPEND actions "    {${id}, true},\n")
            elseif(action STREQUAL "collapse")
                string(APPEND actions "    {${id}, false},\n")
            else()
                message(FATAL_ERROR "Preset ${preset}: unknown action ${action}")
            endif()
            math(EXPR action_count "${action_count}+1")
        endif()
    endforeach()
    string(APPEND objects "    {-1, -1, NULL}\n};\n")
    string(APPEND actions "    {-1, false}\n};\n")
    file(WRITE "${directory}/fixture_checks.h"
        "#define FIXTURE_PRESET ${preset}\n#define FIXTURE_OBJECT_COUNT ${object_count}u\n#define FIXTURE_ACTION_COUNT ${action_count}u\n${objects}${actions}")
endforeach()
