file(MAKE_DIRECTORY "${BINARY_DIR}")
find_library(runtime_lvgl NAMES lvgl PATHS "${LVGL_BUILD_DIR}" "${LVGL_BUILD_DIR}/Release" NO_DEFAULT_PATH)
if(NOT runtime_lvgl)
    message(FATAL_ERROR "Build the LVGLGenerator96 test first to prepare the standalone LVGL archive")
endif()
function(run_step name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${BINARY_DIR}/${name}.log" "${output}${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Standalone runtime ${name} failed. See ${BINARY_DIR}/${name}.log\n${error}")
    endif()
endfunction()
run_step(configure "${CMAKE_COMMAND}" -S "${SOURCE_ROOT}/Tests/Integration/Runtime/Standalone" -B "${BINARY_DIR}"
    -G "${PARENT_GENERATOR}" -DCMAKE_BUILD_TYPE=Release -DLVGL_RUNTIME_TARGET=9.6 "-DREPOSITORY_ROOT=${SOURCE_ROOT}"
    "-DLVGL_SOURCE_DIR=${SOURCE_ROOT}/3rdParty/LVGL/lvgl" "-DLVGL_ARCHIVE=${runtime_lvgl}" "-DPROJECT_FILE=${PROJECT_FILE}")
run_step(build "${CMAKE_COMMAND}" --build "${BINARY_DIR}" --config Release --parallel 6)
run_step(test "${CMAKE_CTEST_COMMAND}" --test-dir "${BINARY_DIR}" -C Release --output-on-failure)
foreach(target unknown)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_ROOT}/Tests/Integration/Runtime/Standalone" -B "${BINARY_DIR}"
        "-DLVGL_RUNTIME_TARGET=${target}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0)
        message(FATAL_ERROR "Unimplemented runtime target ${target} was silently accepted")
    endif()
    if(NOT "${output}${error}" MATCHES "not implemented|Unknown LVGL_RUNTIME_TARGET")
        message(FATAL_ERROR "Unexpected runtime selection error for ${target}: ${output}${error}")
    endif()
endforeach()
