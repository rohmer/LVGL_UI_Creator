cmake_minimum_required(VERSION 3.24)
foreach(required SOURCE_ROOT BINARY_DIR PYTHON)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
function(run_step name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    file(WRITE "${BINARY_DIR}/${name}.log" "${output}\n${errors}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Minimal Advanced Keyboard ${name} failed (${result})\n${output}\n${errors}")
    endif()
endfunction()
file(MAKE_DIRECTORY "${BINARY_DIR}")
set(harness "${SOURCE_ROOT}/Tests/Integration/Runtime/Minimal")
if(NOT PROJECT_FILE)
    set(PROJECT_FILE "${harness}/keyboard.json")
endif()
run_step(bundle "${PYTHON}" "${SOURCE_ROOT}/Runtime/esp32/make_component.py" "${PROJECT_FILE}"
    --output "${BINARY_DIR}/component" --color-depth 16 --replace)
if(NOT PARENT_GENERATOR)
    set(PARENT_GENERATOR Ninja)
endif()
run_step(configure "${CMAKE_COMMAND}" -S "${harness}" -B "${BINARY_DIR}/build" -G "${PARENT_GENERATOR}"
    -DCMAKE_BUILD_TYPE=Release -DLVGL_PB_ADVANCED_KEYBOARD_TEST=ON "-DLVGL_PB_COMPONENT_DIR=${BINARY_DIR}/component")
run_step(build "${CMAKE_COMMAND}" --build "${BINARY_DIR}/build" --config Release --parallel 6)
run_step(functional "${CMAKE_CTEST_COMMAND}" --test-dir "${BINARY_DIR}/build" -C Release --output-on-failure)
message(STATUS "Minimal Advanced Keyboard component compiled, linked, loaded, rendered and passed two-way binding/lifetime checks")
