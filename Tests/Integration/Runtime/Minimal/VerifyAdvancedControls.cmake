cmake_minimum_required(VERSION 3.24)
foreach(required SOURCE_ROOT BINARY_DIR PYTHON PROJECT_FILE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
function(run_step name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    file(WRITE "${BINARY_DIR}/${name}.log" "${output}\n${errors}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Minimal advanced controls ${name} failed (${result})\n${output}\n${errors}")
    endif()
endfunction()
file(MAKE_DIRECTORY "${BINARY_DIR}")
run_step(bundle "${PYTHON}" "${SOURCE_ROOT}/Runtime/esp32/make_component.py" "${PROJECT_FILE}"
    --output "${BINARY_DIR}/component" --color-depth 16 --replace)
if(NOT PARENT_GENERATOR)
    set(PARENT_GENERATOR Ninja)
endif()
set(parent_options)
set(requested_toolchain "")
set(consumer_build "${BINARY_DIR}/build")
if(PARENT_TOOLCHAIN)
    get_filename_component(requested_toolchain "${PARENT_TOOLCHAIN}" REALPATH BASE_DIR "${consumer_build}")
endif()
if(EXISTS "${consumer_build}/CMakeCache.txt")
    file(STRINGS "${consumer_build}/CMakeCache.txt" cached_toolchain REGEX "^CMAKE_TOOLCHAIN_FILE:[^=]*=")
    string(REGEX REPLACE "^[^=]*=" "" cached_toolchain "${cached_toolchain}")
    if(cached_toolchain)
        get_filename_component(cached_toolchain "${cached_toolchain}" REALPATH BASE_DIR "${consumer_build}")
    endif()
    if(NOT cached_toolchain STREQUAL requested_toolchain)
        list(APPEND parent_options --fresh)
    endif()
endif()
if(PARENT_TOOLCHAIN)
    list(APPEND parent_options "-DCMAKE_TOOLCHAIN_FILE=${PARENT_TOOLCHAIN}")
endif()
if(PARENT_EMULATOR_SETTINGS)
    list(APPEND parent_options -C "${PARENT_EMULATOR_SETTINGS}")
endif()
run_step(configure "${CMAKE_COMMAND}" ${parent_options} -S "${SOURCE_ROOT}/Tests/Integration/Runtime/Minimal"
    -B "${consumer_build}" -G "${PARENT_GENERATOR}" -DCMAKE_BUILD_TYPE=Release
    -DLVGL_PB_ADVANCED_CONTROLS_TEST=ON "-DLVGL_PB_COMPONENT_DIR=${BINARY_DIR}/component")
run_step(build "${CMAKE_COMMAND}" --build "${consumer_build}" --config Release --parallel 6)
run_step(functional "${CMAKE_CTEST_COMMAND}" --test-dir "${consumer_build}" -C Release --output-on-failure)
message(STATUS "Project-selected advanced controls compiled, linked and passed runtime/render/lifecycle checks")
