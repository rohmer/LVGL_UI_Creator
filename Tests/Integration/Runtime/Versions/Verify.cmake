function(run_step name)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${BINARY_DIR}/${name}.log" "${output}${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Runtime ${TARGET_VERSION}: ${name} failed (${result}). See ${BINARY_DIR}/${name}.log\n${output}${error}")
    endif()
endfunction()
file(MAKE_DIRECTORY "${BINARY_DIR}")
set(runtime_parent_options)
set(runtime_requested_toolchain "")
if(PARENT_TOOLCHAIN)
    get_filename_component(runtime_requested_toolchain "${PARENT_TOOLCHAIN}" REALPATH BASE_DIR "${BINARY_DIR}")
endif()
# A fixture cache must follow its parent when switching to or from a toolchain.
if(EXISTS "${BINARY_DIR}/CMakeCache.txt")
    file(STRINGS "${BINARY_DIR}/CMakeCache.txt" runtime_cached_toolchain
        REGEX "^CMAKE_TOOLCHAIN_FILE:[^=]*=")
    string(REGEX REPLACE "^[^=]*=" "" runtime_cached_toolchain "${runtime_cached_toolchain}")
    if(runtime_cached_toolchain)
        get_filename_component(runtime_cached_toolchain "${runtime_cached_toolchain}" REALPATH BASE_DIR "${BINARY_DIR}")
    endif()
    if(NOT runtime_cached_toolchain STREQUAL runtime_requested_toolchain)
        list(APPEND runtime_parent_options --fresh)
    endif()
endif()
if(PARENT_TOOLCHAIN)
    list(APPEND runtime_parent_options "-DCMAKE_TOOLCHAIN_FILE=${PARENT_TOOLCHAIN}")
endif()
set(runtime_compiler_emulator)
if(PARENT_EMULATOR_SETTINGS)
    include("${PARENT_EMULATOR_SETTINGS}")
    set(runtime_compiler_emulator "${CMAKE_CROSSCOMPILING_EMULATOR}")
    list(APPEND runtime_parent_options -C "${PARENT_EMULATOR_SETTINGS}")
endif()
find_library(runtime_lvgl NAMES lvgl PATHS "${LVGL_BUILD_DIR}" "${LVGL_BUILD_DIR}/Release" NO_DEFAULT_PATH)
if(NOT runtime_lvgl)
    message(FATAL_ERROR "Run the LVGL generator matrix first to prepare ${TARGET_VERSION}")
endif()
run_step(widgets ${runtime_compiler_emulator} "${COMPILER}" "${WIDGET_INPUT}" --target "${TARGET_VERSION}" -f pb -o "${BINARY_DIR}/widgets.pb")
run_step(assets ${runtime_compiler_emulator} "${COMPILER}" "${ASSET_INPUT}" --target "${TARGET_VERSION}" -f pb -o "${BINARY_DIR}/assets.pb")
find_program(runtime_ninja ninja)
if(runtime_ninja)
    set(generator Ninja)
else()
    set(generator "${PARENT_GENERATOR}")
endif()
run_step(configure "${CMAKE_COMMAND}" ${runtime_parent_options} -S "${SOURCE_ROOT}/Tests/Integration/Runtime/Versions" -B "${BINARY_DIR}"
    -G "${generator}" -DCMAKE_BUILD_TYPE=Release "-DLVGL_RUNTIME_TARGET=${TARGET_VERSION}" "-DREPOSITORY_ROOT=${SOURCE_ROOT}"
    "-DLVGL_SOURCE_DIR=${LVGL_SOURCE_DIR}" "-DLVGL_ARCHIVE=${runtime_lvgl}" "-DCATCH_ARCHIVE=${CATCH_ARCHIVE}"
    "-DMEDIA_CASES=${MEDIA_CASES}" "-DWIDGET_PROJECT=${BINARY_DIR}/widgets.pb" "-DASSET_PROJECT=${BINARY_DIR}/assets.pb")
run_step(build "${CMAKE_COMMAND}" --build "${BINARY_DIR}" --config Release --parallel 6)
run_step(tests "${CMAKE_CTEST_COMMAND}" --test-dir "${BINARY_DIR}" -C Release --output-on-failure)
