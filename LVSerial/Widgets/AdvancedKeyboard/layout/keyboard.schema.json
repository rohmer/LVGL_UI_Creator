{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESPOS keyboard definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "initialLayout", "width", "layouts"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_-]*$" },
    "initialLayout": { "$ref": "#/$defs/id" },
    "width": { "type": "number", "exclusiveMinimum": 0 },
    "layouts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/layout" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "shiftedLayout": { "$ref": "#/$defs/id" },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "offset": { "type": "number", "minimum": 0, "default": 0 },
        "keys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/key" } }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "action": { "$ref": "#/$defs/action" },
        "doubleTapAction": { "$ref": "#/$defs/action" },
        "variants": {
          "description": "Unicode alternatives shown after a one-second hold, in display order. Only insert keys support variants; each entry is inserted as one string.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029\\uD800-\\uDFFF]+$"
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["variants"] },
          "then": { "properties": { "action": { "properties": { "type": { "const": "insert" } } } } }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "insert" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "layout"],
          "properties": {
            "type": { "const": "switch_layout" },
            "layout": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["shift", "shift_lock", "backspace", "enter"] }
          }
        }
      ]
    }
  }
}
