<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CorpusWorkbench" />
    <InternalsVisibleTo Include="CorpusLanguageTests" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
    <Compile Include="../CorpusCrawler/OpenNlpSentences.cs" Link="OpenNlpSentences.cs" />
    <Compile Include="../CorpusCrawler/UnicodeSentenceFallback.cs" Link="UnicodeSentenceFallback.cs" />
    <None Include="../CorpusCrawler/OpenNlp/SentenceWorker.java" Link="OpenNlp/SentenceWorker.java"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../CorpusCrawler/OpenNlp/dependencies/*.jar" Link="OpenNlp/dependencies/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../CorpusCrawler/OpenNlp/java-home.txt" Link="OpenNlp/java-home.txt"
          Condition="Exists('../CorpusCrawler/OpenNlp/java-home.txt')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
