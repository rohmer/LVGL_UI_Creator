<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CorpusWorkbench" />
    <InternalsVisibleTo Include="CorpusLanguageTests" />
    <PackageReference Include="AngleSharp" Version="1.9.0" />
    <PackageReference Include="SearchPioneer.Lingua" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="OpenNlp/SentenceWorker.java;OpenNlp/dependencies/*.jar;OpenNlp/java-home.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
